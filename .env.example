# Copy this file to .env and fill in the values. Never commit the real .env.
POSTGRES_USER=spendsense
POSTGRES_PASSWORD=change_me
POSTGRES_DB=spendsense

# Inside Docker Compose the database host is the service name "db"
DATABASE_URL=postgresql+psycopg2://spendsense:change_me@db:5432/spendsense
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Razorpay TEST-mode keys (leave blank to disable payments). Get them from the Razorpay dashboard
# in Test Mode: Account & Settings -> API Keys. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRO_PRICE_PAISE=19900

